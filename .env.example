# Copy this file to .env and set a real Agent token locally.
# Never commit .env or paste a live token into source code.
ARENA_HERO_API_KEY=replace-with-your-agent-token
ARENA_HERO_MAX_POPULATION=30
ARENA_HERO_WORKER_TARGET=16
ARENA_HERO_VANGUARD_TARGET=6
ARENA_HERO_RANGER_TARGET=8
ARENA_HERO_SPAWN_UNIT=AUTO
ARENA_HERO_BEACON_POLICY=RETREAT
ARENA_HERO_SUBMIT_RETRIES=3
ARENA_HERO_RECONNECT_MAX_DELAY=30
ARENA_HERO_MAX_RECONNECT_ATTEMPTS=8
ARENA_HERO_LOG_LEVEL=INFO
ARENA_HERO_LOG_FILE=arena_agent.log
ARENA_HERO_STATE_FILE=arena_agent_state.json
ARENA_HERO_TRACE_FILE=arena_agent_trace.jsonl
ARENA_HERO_STATS_FILE=arena_agent_stats.json
